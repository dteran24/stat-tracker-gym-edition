# SQLite database path (on Railway, mount a Volume at /data and set /data/stat-tracker.db)
STAT_TRACKER_DB_PATH=./data/stat-tracker.db

# Enforce Google Sign-In even outside NODE_ENV=production (leave false for local dev fallback)
PUBLIC_MODE=false

# Google OAuth 2.0 Web Client credentials (required when PUBLIC_MODE=true or NODE_ENV=production)
# Authorized redirect URI: https://<your-railway-domain>/api/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=blah

# Optional explicit public URL (auto-detected from Railway proxy headers if omitted)
# APP_URL=https://your-app.up.railway.app

# Optional read-only API key for automated GET /api/state exports (e.g. fitness-coach-cli)
# STAT_TRACKER_API_KEY=
# Optional user_id override when multiple Google accounts exist in SQLite (auto-resolves if only 1 user exists)
# STAT_TRACKER_API_USER_ID=
